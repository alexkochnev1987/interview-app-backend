{
  "name": "interview-app-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "openapi:generate": "ts-node src/openapi/generate-openapi.ts",
    "openapi:types": "openapi-typescript openapi/openapi.json -o openapi/generated/api.d.ts",
    "openapi:validate": "ts-node src/openapi/validate-openapi.ts",
    "openapi:check": "npm run openapi:generate && npm run openapi:types && npm run openapi:validate && git diff --exit-code -- openapi/openapi.json openapi/generated/api.d.ts",
    "db:migrate": "ts-node src/database/migrate.ts",
    "db:migrate:prod": "node dist/database/migrate.js",
    "migrations:check": "node scripts/check-migrations.js",
    "seed:demo": "ts-node src/database/seed-demo.ts",
    "seed:demo:prod": "node dist/database/seed-demo.js",
    "start": "npm run db:migrate && nest start",
    "start:dev": "npm run db:migrate && nest start --watch",
    "start:prod": "npm run db:migrate:prod && node dist/main",
    "lint": "oxlint -f unix",
    "fmt": "oxfmt --write",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:integration": "vitest run --config ./test/vitest-integration.config.mts",
    "test:pyramid": "npm run test && npm run test:integration && node test/assert-test-pyramid.js",
    "test:pyramid:check": "node test/assert-test-pyramid.js",
    "questions:import": "ts-node src/question/import-questions.ts",
    "questions:backfill-embeddings": "ts-node src/question/backfill-embeddings.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1106.0",
    "@aws-sdk/client-s3": "^3.1106.0",
    "@aws-sdk/s3-request-presigner": "^3.1106.0",
    "@nestjs/common": "^10.4.22",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^10.4.22",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^6.5.0",
    "@types/pg": "^8.21.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@nestjs/cli": "^10.4.9",
    "@nestjs/testing": "^10.4.22",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/node": "^26.2.0",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "supertest": "^7.1.0",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.0",
    "typescript": "^5.9.3",
    "unplugin-swc": "^1.5.10",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "oxfmt --write --no-error-on-unmatched-pattern",
      "oxlint --no-error-on-unmatched-pattern"
    ]
  }
}
